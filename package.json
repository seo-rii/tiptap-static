{
	"name": "tiptap-static",
	"version": "0.1.1",
	"description": "Sanitize or lightly enhance Tiptap HTML with existing extensions, without creating an editor",
	"keywords": [
		"tiptap",
		"prosemirror",
		"static-renderer",
		"hydration",
		"sanitization",
		"svelte",
		"react",
		"vue"
	],
	"author": "Seorii",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@10.30.0",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./light": {
			"types": "./dist/light.d.ts",
			"import": "./dist/light.js",
			"default": "./dist/light.js"
		},
		"./hydrate": {
			"types": "./dist/hydrate.d.ts",
			"import": "./dist/hydrate.js",
			"default": "./dist/hydrate.js"
		},
		"./protocol": {
			"types": "./dist/protocol.d.ts",
			"import": "./dist/protocol.js",
			"default": "./dist/protocol.js"
		},
		"./sanitize": {
			"types": "./dist/sanitize.d.ts",
			"import": "./dist/sanitize.js",
			"default": "./dist/sanitize.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.json",
		"prebenchmark": "pnpm build",
		"benchmark": "node benchmark/ci.mjs",
		"benchmark:ci": "node benchmark/ci.mjs",
		"prebenchmark:render": "pnpm build",
		"benchmark:render": "node benchmark/render.mjs",
		"prebenchmark:size": "pnpm build",
		"benchmark:size": "node benchmark/bundle-size.mjs",
		"check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json && tsc -p tsconfig.framework-tests.json",
		"test": "vitest run",
		"test:dist": "node --test test/dist-boundary.mjs",
		"test:watch": "vitest",
		"pack:check": "pnpm build && pnpm test:dist && publint",
		"prepublishOnly": "pnpm check && pnpm test",
		"prepack": "pnpm pack:check"
	},
	"dependencies": {
		"sanitize-html": "^2.17.1"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"@tiptap/core": "3.28.0",
		"@tiptap/extension-bubble-menu": "3.28.0",
		"@tiptap/extension-code-block": "3.28.0",
		"@tiptap/extension-floating-menu": "3.28.0",
		"@tiptap/pm": "3.28.0",
		"@tiptap/react": "3.28.0",
		"@tiptap/vue-3": "3.28.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/sanitize-html": "^2.16.1",
		"esbuild": "0.28.1",
		"jsdom": "^29.0.2",
		"publint": "^0.3.21",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"svelte": "5.57.2",
		"svelte-tiptap": "3.0.2",
		"typescript": "^6.0.3",
		"vitest": "^4.1.4",
		"vue": "3.5.43"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/seo-rii/tiptap-static.git"
	},
	"homepage": "https://github.com/seo-rii/tiptap-static#readme",
	"bugs": {
		"url": "https://github.com/seo-rii/tiptap-static/issues"
	}
}
